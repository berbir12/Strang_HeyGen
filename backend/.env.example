# Required for video generation
OPENAI_API_KEY=
HEYGEN_API_KEY=
VIDEO_ENGINE=hyperframes
HEYGEN_TTS_VOICE_ID=
HEYGEN_TTS_LOCALE=en-US
HEYGEN_TTS_SPEED=1.0
HYPERFRAMES_FPS=30
HYPERFRAMES_QUALITY=standard
HYPERFRAMES_SCENE_PADDING_SEC=0.35

# Public URLs
LANDING_PAGE_URL=https://www.thestrang.com
LANDING_PAGE_URL_FOR_REFERRAL=https://www.thestrang.com
PUBLIC_API_BASE_URL=https://your-strang-api.onrender.com
CORS_ORIGINS=https://www.thestrang.com,https://thestrang.com

# Supabase authentication
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional legacy extension API key
STRANG_API_KEY=

# Product limits
FREE_TIER_VIDEO_LIMIT=1
PRO_TIER_VIDEO_LIMIT=20

# SQLite is suitable for local development only on an ephemeral free host.
DATA_DIR=.
